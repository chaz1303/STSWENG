# Copy to mobile/.env. Only EXPO_PUBLIC_ values reach the app, and they ship inside it: no secrets here.
# Express API (src/server). Unused until the services stop returning mock data.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Public OAuth IDs for Google and Facebook sign-in. Unused until real sign-in is wired up.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
# 1 shows the Dev switcher (mock booking statuses, failure cases). Defaults to on in development.
EXPO_PUBLIC_DEV_TOOLS=
