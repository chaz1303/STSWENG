# Copy to .env and fill in locally. Never commit real values.
PORT=3000
# PostgreSQL on Supabase. User Side connects as its own role, user_side.
DATABASE_URL=postgresql://user_side:<your-full-password>@<host>:5432/postgres
# Path to Supabase's root CA (prod-ca-2021.crt, from Project Settings > Database > SSL). Leave empty for a local Postgres without TLS.
DATABASE_CA_FILE=
# Signs login tokens. At least 32 random characters, for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Base URL of the app, used to build email verification links (soft verification, U01).
APP_URL=http://localhost:3000
# Email provider for verification links is undecided; add its settings here once chosen.
# Shared password of the demo residents (Bruce, Clark, Diana) created by `npm run seed`.
# 8+ characters with an uppercase letter, a number and a special character.
DEMO_PASSWORD=
