{
  "name": "mang-juan-user-side",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:anim": "vite build -c vite.anim.config.js",
    "dev:anim": "vite build -c vite.anim.config.js --watch",
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "mock-aide": "node --env-file-if-exists=.env src/server/mock-aide.js",
    "seed": "node --env-file-if-exists=.env db/seed.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:e2e": "npm run build && robot --outputdir reports/e2e tests/e2e"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
